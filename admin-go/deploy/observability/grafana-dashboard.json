{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(manager_http_requests_total[5m]))", "legendFormat": "requests"}],
      "title": "Request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(manager_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(manager_http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx"
        },
        {
          "expr": "sum(rate(manager_login_failures_total[5m])) / clamp_min(sum(rate(manager_http_requests_total{route=~\".*/(auth|token_auth_server|openId_auth)\"}[5m])), 0.001)",
          "legendFormat": "login failures"
        }
      ],
      "title": "Error ratios",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(manager_http_request_duration_seconds_bucket[5m])))", "legendFormat": "P95"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(manager_http_request_duration_seconds_bucket[5m])))", "legendFormat": "P99"}
      ],
      "title": "Request latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"min": 0, "max": 1}},
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 8},
      "id": 4,
      "targets": [{"expr": "manager_controller_available", "legendFormat": "available"}],
      "title": "Controller availability",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 8},
      "id": 5,
      "targets": [{"expr": "process_resident_memory_bytes", "legendFormat": "RSS"}],
      "title": "Resident memory",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
      "id": 6,
      "targets": [{"expr": "go_goroutines", "legendFormat": "goroutines"}],
      "title": "Goroutines",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "id": 7,
      "targets": [
        {"expr": "manager_cache_entries / manager_cache_capacity_entries", "legendFormat": "{{cache}} entries"},
        {"expr": "manager_cache_bytes / manager_cache_capacity_bytes", "legendFormat": "{{cache}} bytes"},
        {"expr": "manager_sessions / manager_session_capacity", "legendFormat": "sessions"}
      ],
      "title": "Capacity utilization",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 8,
      "targets": [
        {"expr": "sum by (reason) (rate(manager_controller_failures_total[5m]))", "legendFormat": "Controller {{reason}}"},
        {"expr": "sum by (cache) (rate(manager_cache_evictions_total[5m]))", "legendFormat": "cache {{cache}} evictions"}
      ],
      "title": "Downstream failures and evictions",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 9,
      "targets": [
        {"expr": "manager_support_operations_running", "legendFormat": "running"},
        {"expr": "sum by (outcome) (increase(manager_support_operations_total[1h]))", "legendFormat": "{{outcome}} / hour"}
      ],
      "title": "Support operations",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["neuvector", "manager"],
  "templating": {
    "list": [
      {
        "current": {},
        "label": "Prometheus",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "NeuVector Manager",
  "uid": "neuvector-manager",
  "version": 1
}
